FOR UPDATE
AS
INSERT INTO logi(kasutaja, kuupaev, sisestatudAndmed)
SELECT
SUSER_NAME(),
GETDATE(),  
CONCAT('vanad andmed  -kliendi id: ', deleted.kliendi_id,
', toote_id: ', deleted.toote_id,
'uued andmed -kliendi_id: ', inserted.kliendi_id,
', toote_id: ', inserted.toote_id) 
FROM deleted
