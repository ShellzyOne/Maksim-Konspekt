--protseduur mis näitab kõik ostud koos kliendi nime ja toote nimetusega
CREATE PROCEDURE spKuvaKliendiOstud
    @klient_id INT
AS
BEGIN
    SELECT
        eesnimi,
        perenimi,
        tootenimi,
        ühikuhind
    FROM Ost
    INNER JOIN klient
        ON kliendi_id = klient_id
    INNER JOIN Toode 
        ON toote_id = toode_id
    WHERE klient_id = @klient_id;
END;


EXEC spKuvaKliendiOstud 2;


--vaade tegemine, näitab kasutaja tema perekonnanime järgi
CREATE VIEW klientvaade2
AS
Select eesnimi, perenimi, toote_id
FROM klient inner join Ost on klient.klient_id=Ost.kliendi_id
WHERE perenimi LIKE 'Allik';

